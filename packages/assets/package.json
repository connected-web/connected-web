    "./manifest.json": "./dist/manifest.json",
    "./favicon.ico": "./dist/favicon.ico",
    "./connected-web-gradient-large.png": "./dist/connected-web-gradient-large.png",
    "./connected-web-flat-large.png": "./dist/connected-web-flat-large.png",
    "./connected-web-gradient-32.png": "./dist/connected-web-gradient-32.png",
    "./connected-web-gradient-64.png": "./dist/connected-web-gradient-64.png",
    "./connected-web-gradient-128.png": "./dist/connected-web-gradient-128.png",
    "./connected-web-gradient-256.png": "./dist/connected-web-gradient-256.png",
    "./connected-web-gradient-512.png": "./dist/connected-web-gradient-512.png",
    "./connected-web-flat-32.png": "./dist/connected-web-flat-32.png",
    "./connected-web-flat-64.png": "./dist/connected-web-flat-64.png",
    "./connected-web-flat-128.png": "./dist/connected-web-flat-128.png",
    "./connected-web-flat-256.png": "./dist/connected-web-flat-256.png",
    "./connected-web-flat-512.png": "./dist/connected-web-flat-512.png",
    "./connected-web-maskable-large.png": "./dist/connected-web-maskable-large.png",
    "./connected-web-maskable-192.png": "./dist/connected-web-maskable-192.png",
    "./connected-web-maskable-512.png": "./dist/connected-web-maskable-512.png"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "sharp": "^0.34.4"
  }
}
