{
  "name": "@connected-web/assets",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "files": [
    "dist",
    "src/index.js",
    "src/index.d.ts",
    "README.md"
  ],
  "exports": {
    ".": {
